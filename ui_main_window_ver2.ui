    <property name="styleSheet">
     <string notr="true">/* 1. СТИЛЬ ДЛЯ САМОЙ РАМКИ И ЗАГОЛОВКА GROUP BOX */
QGroupBox {
    font-size: 14px;
    font-weight: 600;                    /* Делаем текст заголовка полужирным */
    color: #000000;                      /* Красивый темно-синий/серый цвет текста */
    border: 1px solid #dcdde1;           /* Тонкая аккуратная пастельная рамка */
    border-radius: 8px;                  /* Современное мягкое скругление углов */
    margin-top: 12px;                    /* Отступ сверху, чтобы заголовок не налезал на рамку */
    padding-top: 10px;                   /* Внутренний отступ от заголовка до первой радио-кнопки */
    background-color: #ffffff;           /* Белый фон внутри карточки */
}

/* 2. НАСТРОЙКА РАЗМЕЩЕНИЯ ТЕКСТА ЗАГОЛОВКА */
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;       /* Смещаем заголовок в верхний левый угол */
    left: 12px;                          /* Отступ текста от левого края */
    padding: 0 6px;                      /* Белое пространство вокруг текста, чтобы рамка прерывалась */
}

/* 3. СТИЛЬ РАДИО-КНОПОК ВНУТРИ ЭТОГО GROUP BOX */
QRadioButton {
    font-weight: normal;                 /* Сбрасываем жирный шрифт заголовка для кнопок */
    color: #000000;                      /* Спокойный серый цвет для обычного текста */
    font-size: 14px;
    spacing: 8px;                        /* Расстояние между круглым индикатором и текстом */
    padding-left: 6px;                   /* Слегка отодвигаем кнопку от левой рамки */
    background-color: transparent;       /* Прозрачный фон под кнопками */
}

/* Стиль самого круглого индикатора (когда кнопка НЕ выбрана) */
QRadioButton::indicator {
    width: 12px;
    height: 12px;
    border: 2px solid #cbd5e1;
    border-radius: 7px;                  /* Делаем идеально круглым (радиус = ~половина от 15) */
    background-color: #ffffff;
}

/* Эффект при наведении курсора на радио-кнопку */
QRadioButton::indicator:hover {
    border-color: #3498db;               /* Рамка становится синей при наведении */
    background-color: #ffffff;
}

#radio_rnd_break_on::indicator:checked {
    border: 2px solid #808080;
    background-color: #A9A9A9;
	image: url(none);
}

#radio_rnd_break_off::indicator:checked {
    border: 2px solid #808080;
    background-color: #A9A9A9;
	image: url(none);
}
</string>
    </property>
